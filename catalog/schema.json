{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.byu.edu/schemas/desx-catalog.json",
  "title": "DesX Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "categoryOrder",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "categoryOrder": {
      "type": "array",
      "description": "Display order for research (and optional tool) category rows.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/researchItem"
          },
          {
            "$ref": "#/$defs/toolItem"
          }
        ]
      }
    }
  },
  "$defs": {
    "researchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "title",
        "abstract",
        "url",
        "badge",
        "categories"
      ],
      "properties": {
        "kind": {
          "const": "research"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "abstract": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "badge": {
          "type": "string",
          "enum": [
            "journal",
            "conference",
            "whitepaper"
          ]
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "toolItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "title",
        "blurb",
        "url",
        "categories"
      ],
      "properties": {
        "kind": {
          "const": "tool"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "blurb": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
