{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.byu.edu/schemas/desx-catalog.json",
  "title": "DesX Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "categoryOrder",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "categoryOrder": {
      "type": "array",
      "description": "Display order for research (and optional tool) category rows.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/researchItem"
          },
          {
            "$ref": "#/$defs/toolItem"
          },
          {
            "$ref": "#/$defs/courseItem"
          }
        ]
      }
    }
  },
  "$defs": {
    "researchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "title",
        "abstract",
        "badge",
        "categories"
      ],
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "publisherUrl"
          ]
        }
      ],
      "properties": {
        "kind": {
          "const": "research"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "abstract": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "description": "On-site Squarespace landing page slug, e.g. /paper-slug"
        },
        "publisherUrl": {
          "type": "string",
          "minLength": 1,
          "description": "External publisher link, usually https://doi.org/..."
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "badge": {
          "type": "string",
          "enum": [
            "journal",
            "conference",
            "whitepaper"
          ]
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "citationCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Derived citation count (written by enrich_research_citations.py)"
        },
        "citationSource": {
          "type": "string",
          "enum": [
            "openalex"
          ],
          "description": "Source of citationCount"
        },
        "citationsUpdatedAt": {
          "type": "string",
          "format": "date",
          "description": "ISO date when citationCount was last refreshed"
        },
        "hidden": {
          "type": "boolean",
          "description": "If true, the card is omitted from catalog pages."
        }
      }
    },
    "toolItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "title",
        "blurb",
        "url",
        "categories"
      ],
      "properties": {
        "kind": {
          "const": "tool"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "blurb": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hidden": {
          "type": "boolean",
          "description": "If true, the card is omitted from catalog pages."
        }
      }
    },
    "courseItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "title",
        "blurb",
        "url",
        "type",
        "categories"
      ],
      "properties": {
        "kind": {
          "const": "course"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "blurb": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "On-site Squarespace path, e.g. /learn-to-sketch"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "course",
            "workshop",
            "guidebook",
            "tutorial"
          ]
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "description": "Optional short format label, e.g. Self-paced"
        },
        "duration": {
          "type": "string",
          "minLength": 1,
          "description": "Optional duration label, e.g. 8 weeks"
        },
        "tags": {
          "type": "array",
          "description": "Optional chip labels shown on the course card. When present, replaces format/duration chips.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "description": "Explicit Learn-grid sort order (lower first). Items without order sort after numbered ones."
        },
        "hidden": {
          "type": "boolean",
          "description": "If true, the card is omitted from catalog pages."
        }
      }
    }
  }
}
